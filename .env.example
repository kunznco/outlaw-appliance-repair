# =====================================================================
# Outlaw Appliance Repair — environment variables
# Copy to .env.local and fill in (or pull from Doppler when wired up).
# Never commit .env.local — it's gitignored.
# =====================================================================

# Public site URL — used in metadata, sitemap, OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — contact form delivery (wire later when ready to ship contact form)
# Get key at https://resend.com — store in Doppler project `outlaw-appliance-repair`
RESEND_API_KEY=
RESEND_TO_EMAIL=jesse@outlawappliancerepair.com

# Vercel AI Gateway — used by scripts/generate-images.ts (nano-banana 2)
# Local-only — never exposed to client
AI_GATEWAY_API_KEY=

# Pricing displayed on the site — single source of truth so Jesse can update without code change
NEXT_PUBLIC_SERVICE_CALL_PRICE=99
